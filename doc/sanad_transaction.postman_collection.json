    {
      "name": "Bookings",
      "item": [
        {
          "name": "Book Appointment (Patient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('success true', () => pm.expect(json.success).to.be.true);",
                  "pm.test('Slot is BOOKED', () => pm.expect(json.data.appointment.status).to.equal('BOOKED'));",
                  "if (json.data && json.data.booking) {",
                  "  pm.collectionVariables.set('bookingId', json.data.booking._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}"
            }
          }
        },
        {
          "name": "Double Booking — Same Slot (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
