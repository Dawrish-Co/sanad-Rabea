    {
      "name": "Appointments",
      "item": [
        {
          "name": "Create Appointment Slot (Doctor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('success true', () => pm.expect(json.success).to.be.true);",
                  "if (json.data && json.data.appointment) {",
                  "  pm.collectionVariables.set('appointmentId', json.data.appointment._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2025-12-01\",\n  \"startTime\": \"09:00\",\n  \"endTime\": \"09:30\"\n}"
            }
          }
        },
